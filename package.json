{
  "name": "statiq-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:backend": "npm run dev --prefix statiq-ai-backend",
    "dev:web": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env scripts/seed-auth.ts",
    "db:seed-auth": "tsx --env-file=.env scripts/seed-auth.ts",
    "data:sync": "tsx scripts/data-sync.ts",
    "db:studio": "drizzle-kit studio",
    "db:mysql:init": "mysql -u root < scripts/mysql_schema.sql",
    "db:mysql:seed": "mysql -u root < scripts/mysql_seed.sql"
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "@google/genai": "^2.21.0",
    "bcryptjs": "^3.0.2",
    "chromadb": "^3.5.0",
    "drizzle-orm": "^0.44.5",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "groq-sdk": "^1.6.0",
    "jose": "^6.1.0",
    "katex": "^0.18.7",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
